# Leave VITE_API_URL empty in development (Vite proxies /api to localhost:8000).
# In production set it to your deployed backend, e.g. https://my-wedding-api.vercel.app
VITE_API_URL=

# Free photo storage: Cloudinary. Leave both empty in development and uploads
# are saved on your own machine instead.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
